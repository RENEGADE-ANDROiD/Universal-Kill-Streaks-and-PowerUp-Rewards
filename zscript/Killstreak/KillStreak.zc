//===========================================================================
// Universal KillStreak item – uses AUTOACTIVATE + Use() to avoid ambiguous context
//===========================================================================

class KillStreak : Inventory
{
    Default
    {
        Inventory.MaxAmount 1;
        Inventory.PickupSound "HERELA0";
        +FLOATBOB;
        +INVENTORY.AUTOACTIVATE;   // Automatically "used" when picked up
        floatbobstrength 1.2;
        Scale 0.15;
        StencilColor "Yellow";
    }

    override bool Use(bool pickup)
    {
        if (pickup && Owner && Owner is "PlayerPawn")
        {
            let plr = PlayerPawn(Owner);
            if (plr && !plr.FindInventory("KillStreakActive"))
            {
                plr.GiveInventory("KillStreakActive", 1);

                if (KSHUD)
                {
                    let handler = EventHandler.Find("PandHUDMessageHandler");
                    if (handler && handler is "PandHUDMessageHandler")
                    {
                        PandHUDMessageHandler.PlainMsg(plr.PlayerNumber(), "BIGFONT2",
                            "KillStreak Activated!", (240,120), (480,360), time:(0.2,3,0.5), id:11);
                    }
                    else
                    {
                        plr.A_Print("KillStreak Activated!", 2.0);
                    }
                }
                else
                {
                    plr.A_Print("KillStreak Activated!", 2.0);
                }
            }
        }
        // Return true to consume the item (remove it from inventory)
        return true;
    }

    States
    {
    Spawn:
        KIST ABCDEFGHIJKLMNOPQRST 2;
        Loop;
    }
}

class KillStreakActive : Inventory
{
    Default
    {
        Inventory.MaxAmount 1;
        +INVENTORY.AUTOACTIVATE;
        +INVENTORY.HUBPOWER;
    }
}