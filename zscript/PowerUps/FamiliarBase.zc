// RoboDog kill-streak familiar (PBWP fold-in).

class KS_RoboDogFamiliarHandler : StaticEventHandler
{
	override void WorldThingSpawned(WorldEvent e)
	{
		if (!e.Thing || e.Thing.GetClassName() != 'KS_RoboDogFamiliar')
			return;
		let dog = e.Thing;
		if (dog.master && dog.master.player)
			dog.target = dog.master;
	}
}

class KS_PlayerTokenHandler : StaticEventHandler
{
	void KS_GivePlayerToken(PlayerPawn mo)
	{
		if (mo)
			mo.GiveInventory("IsPlayer", 1);
	}

	override void PlayerEntered(PlayerEvent e)
	{
		if (!e)
			return;
		int pn = e.PlayerNumber;
		if (pn < 0 || pn >= MAXPLAYERS || !playeringame[pn])
			return;
		KS_GivePlayerToken(PlayerPawn(players[pn].mo));
	}

	override void PlayerRespawned(PlayerEvent e)
	{
		if (!e)
			return;
		int pn = e.PlayerNumber;
		if (pn < 0 || pn >= MAXPLAYERS || !playeringame[pn])
			return;
		KS_GivePlayerToken(PlayerPawn(players[pn].mo));
	}
}

class FamiliarSummon : CustomInventory
{
	Default
	{
		Radius 12;
		Height 20;
		+INVENTORY.INVBAR;
		+INVENTORY.FANCYPICKUPSOUND;
		+COUNTITEM;
		+INVENTORY.AUTOACTIVATE;
		+INVENTORY.ALWAYSPICKUP;
		Inventory.MaxAmount 5;
		Inventory.InterHubAmount 5;
		Inventory.Icon "FAMSZ0";
		Inventory.PickupMessage "RoboDog companion summon sphere";
		Inventory.PickupSound "misc/p_pkup";
	}

	States
	{
	Spawn:
		FAMS ABCDCB 4 Bright;
		Loop;
	Use:
		TNT1 A 0 A_SpawnItemEx("FamiliarSummonThrown", 0, 0, 32, 20, 0, 0, 0, SXF_NOCHECKPOSITION | SXF_SETMASTER);
		TNT1 A 0 A_PlaySound("familiar/throw");
		Stop;
	}

	transient bool pbBlockCheatGive;

	override void SetGiveAmount(Actor receiver, int amount, bool givecheat)
	{
		if (givecheat)
		{
			pbBlockCheatGive = true;
			Amount = 0;
			return;
		}
		Super.SetGiveAmount(receiver, amount, givecheat);
	}

	override bool TryPickup(in out Actor toucher)
	{
		if (pbBlockCheatGive)
			return false;
		return Super.TryPickup(toucher);
	}
}
